{
	acme_dns porkbun {
		api_key {env.PORKBUN_API_KEY}
		api_secret_key {env.PORKBUN_SECRET_API_KEY}
	}

	order crowdsec first
	crowdsec {
		api_url http://host.docker.internal:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
	}
}

(secured_site) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
	crowdsec
}

(local_only) {
	
	@denied {
		not remote_ip 192.168.1.0/24 192.168.2.0/24
	}

	abort @denied

	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}

# Authentik is on the same VM — use Docker container name directly
auth.doxy.moe {
	import secured_site
	reverse_proxy http://authentik-server:9000
}

